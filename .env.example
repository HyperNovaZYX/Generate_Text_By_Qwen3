# 复制本文件为 .env 或在服务器 shell 中 export 以下环境变量

# Qwen3 AWQ 模型目录或 HuggingFace 模型 ID
GEN_MODEL_PATH=/path/to/Qwen3-4B-AWQ

# vLLM 最大上下文长度（建议 >= 3072，给 <think> 推理与 JSON 输出留足预算）
GEN_MAX_MODEL_LEN=3072

# 单卡显存占用比例（多任务共享显卡时可按需调低，如 0.45）
GEN_GPU_UTIL=0.55

# SQLite 持久化去重索引路径（默认 data/dedup_index.sqlite，多卡并行可共享同一文件）
GEN_DEDUP_DB=data/dedup_index.sqlite
