# ============================================================================
# 生成数据、导出语料与运行日志（包含生成样本及服务器路径，禁止提交到仓库）
# ============================================================================
text/
text_backup_*/
final/
logs/
*.log
*.out

# 业务历史参考样本、私有业务提示词配置与持久化去重数据库
configs/*.py
!configs/__init__.py
!configs/_example.py
data/reference/*.txt
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
*.db

# 临时与备份文件
*.tmp
*.bak
*_old.jsonl
*_backup*.jsonl

# 本地环境变量（仅提交 .env.example 模板）
.env
.env.*
!.env.example

# ============================================================================
# Python / 测试 / IDE / 操作系统缓存
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/

.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
